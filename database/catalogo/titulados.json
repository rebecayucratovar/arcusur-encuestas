         "options": [["insatisfecho", "Insatisfecho"], ["algo_satisfecho", "Algo satisfecho"], ["satisfecho", "Satisfecho"]]},
        {"code": "importancia_formacion_negocio", "type": "likert", "required": true,
         "prompt": "¿Qué tan importante considera que fue su formación en Ingeniería en Sistemas para iniciar y gestionar su negocio?",
