         "options": [["teoria_practica", "Mayor integración de la teoría con aplicaciones prácticas en el plan de estudios."], ["relacion_empresas", "Mayor relacionamiento del estudiante con las empresas por medio de práctica profesionales."], ["horarios", "La distribución de horarios de clases. (Horario para trabajadores, módulos virtuales, etc)"], ["actualizacion_plan", "Actualización constante del plan de estudios para atender tendencias actuales."], ["extracurriculares", "Incremento de actividades extracurriculares (Investigación, servicio social, etc)"], ["especializacion", "Ofrecimiento de más opciones de especialización."]]},
        {"code": "asignaturas_ventaja", "type": "multiple_choice", "required": true,
         "prompt": "Indique 5 asignaturas cursadas en la Carrera que considera que le brindaron una ventaja competitiva al momento de buscar trabajo o desenvolverse profesionalmente.",
         "help": "Seleccione 5 opciones.",
         "config": {"min_selected": 5, "max_selected": 5, "other_question": "otra_ventaja"},
         "options": [["introduccion", "Introducción"], ["base_datos", "Base de Datos"], ["ia", "Inteligencia Artificial"], ["redes", "Redes de Computadora"], ["electivas", "Electivas"], ["tis", "T.I.S."], ["basicas", "Básicas (Física, Calculo, Algebras)"], ["planificacion", "Planificación de Proyectos y Gestión"], ["redes_avanzadas", "Tecnologia Redes Avanzadas"]]},
        {"code": "otra_ventaja", "type": "short_text", "required": false,
         "prompt": "Otra asignatura:",
         "config": {"other_for": "asignaturas_ventaja"}},
        {"code": "asignaturas_no_utiles", "type": "multiple_choice", "required": true,
         "prompt": "Indique 5 asignaturas cursadas en la Carrera que no le resultaron de mucha utilidad en su vida profesional.",
         "help": "Seleccione 5 opciones.",
         "config": {"min_selected": 5, "max_selected": 5, "other_question": "otra_no_util"},
         "options": [["basicas", "Básicas (Física, Calculo, Algebras)"], ["tv_digital", "Aplic. Interactivas para Televisión Digital"], ["telefonia_ip", "Telefonía IP"], ["web_semanticas", "Web Semánticas"], ["graficacion", "Graficación por Computadora"], ["robotica", "Robótica"], ["bajo_nivel", "Taller de Programación en Bajo Nivel"], ["automatas", "Teoría de Autómatas y Leng. Formales"], ["funcional", "Programación Funcional"], ["grafos", "Teoría de Grafos"], ["contabilidad", "Contabilidad Básica"]],
         "note": "El formulario dice 'Seleccione 5'; el anexo de la guía dice 'Seleccione 2'. Se usa 5 (formulario real)."},
        {"code": "otra_no_util", "type": "short_text", "required": false,
