         "config": {"scores": {"no_importante": 1, "poco_importante": 2, "importante": 3, "muy_importante": 4}},
         "options": [["no_importante", "No es importante"], ["poco_importante", "Poco Importante"], ["importante", "Importante"], ["muy_importante", "Muy importante"]]}
      ]
