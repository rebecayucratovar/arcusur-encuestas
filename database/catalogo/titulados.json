{
  "survey": "titulados",
  "version": 1,
  "source": "encuesta.pdf (capturas del formulario Microsoft Forms)",
  "sections": [
    {
      "title": "Datos generales",
      "questions": [
        {"code": "edad", "type": "single_choice", "required": true,
         "config": {"widget": "dropdown"},
         "prompt": "Edad que tiene actualmente:",
         "options": [["15_18", "15 - 18 años"], ["19_22", "19 - 22 años"], ["23_26", "23 - 26 años"], ["27_30", "27 - 30 años"], ["31_34", "31 - 34 años"], ["35_mas", "35 años o más"]]},
        {"code": "genero", "type": "single_choice", "required": true,
         "config": {"widget": "dropdown"},
         "prompt": "Género:",
         "options": [["hombre", "Hombre"], ["mujer", "Mujer"]]},
        {"code": "formacion", "type": "single_choice", "required": true,
         "prompt": "Posterior a sus estudios de pregrado en Ingeniería en Sistemas, ¿Ha realizado o se encuentra realizando algún programa de formación complementaria? (programas de posgrado, diplomados, doble titulación por diplomado, especializaciones, etc)",
         "options": [["si", "SI"], ["no", "NO"]]},
        {"code": "nivel_formacion", "type": "single_choice", "required": true,
         "prompt": "¿CUÁL ES EL PROGRAMA DE FORMACIÓN COMPLEMENTARIA DE MAYOR NIVEL QUE HA CONCLUIDO O QUE SE ENCUENTRA REALIZANDO?",
         "if": {"q": "formacion", "eq": "si"},
         "options": [["diplomado", "DIPLOMADO"], ["especialidad", "ESPECIALIDAD"], ["maestria", "MAESTRIA"], ["doctorado", "DOCTORADO"], ["posdoctorado", "POS DOCTORADO"]]},
        {"code": "donde_programa", "type": "single_choice", "required": true,
         "prompt": "¿DONDE HA CURSADO EL PROGRAMA INDICADO?",
         "if": {"q": "formacion", "eq": "si"},
         "options": "@instituciones"},
        {"code": "financiamiento", "type": "single_choice", "required": true,
         "prompt": "¿CUÁL FUE LA FUENTE DE FINANCIAMIENTO PARA CURSAR EL PROGRAMA INDICADO?",
         "if": {"q": "formacion", "eq": "si"},
         "options": [["recursos_propios", "FINANCIADO CON RECURSOS PROPIOS"], ["beca_total", "TOTAL FINANCIAMIENTO POR MEDIO DE UNA BECA"], ["beca_parcial", "FINANCIADO PARCIALMENTE POR MEDIO DE UNA BECA"]]},
        {"code": "nombre_programa", "type": "short_text", "required": false,
         "prompt": "INDIQUE EL NOMBRE DEL PROGRAMA",
         "if": {"q": "formacion", "eq": "si"}},
        {"code": "interes_posgrado", "type": "single_choice", "required": true,
         "prompt": "¿ESTARÍA INTERESADO EN REALIZAR ESTUDIOS EN ALGÚN PROGRAMA DE POSGRADO DENTRO DE LAS ÁREAS DE LA INGENIERÍA EN SISTEMAS?",
         "options": [["si", "SI"], ["no", "NO"]]},
        {"code": "area_posgrado", "type": "single_choice", "required": true,
         "prompt": "¿EN CUÁL DE LAS SIGUIENTES ÁREAS LE INTERESARÍA REALIZAR EL PROGRAMA?",
         "if": {"q": "interes_posgrado", "eq": "si"},
         "options": [["ia", "IA"], ["robotica", "Robótica"], ["ing_software", "Ingenieria de Software"], ["base_datos", "Base de Datos"], ["redes_seguridad", "Redes de Datos y Seguridad"]]},
        {"code": "organizacion_posgrado", "type": "single_choice", "required": true,
         "prompt": "EN CASO DE REALIZAR UN ESTUDIO DE POSGRADO ¿EN QUÉ ORGANIZACIÓN EDUCATIVA OPTARÍA POR REALIZAR SUS ESTUDIOS DE POSGRADO?",
         "if": {"q": "interes_posgrado", "eq": "si"},
         "options": "@instituciones"},
        {"code": "opinion_posgrado_fcyt", "type": "likert", "required": true,
         "prompt": "¿Considera que existen programas de formación de posgrado ofertados en la Dirección de Posgrado de la FCyT que son afines a las áreas de especialidad de un Ingeniero en Sistemas?",
         "options": "@acuerdo4",
         "note": "Confirmado en el formulario: se muestra tanto con interes_posgrado=SI como NO."}
      ]
    },
    {
      "title": "Vida profesional",
      "questions": [
        {"code": "anios_profesional", "type": "short_text", "required": true,
         "prompt": "¿CUÁNTOS SON LOS AÑOS DE VIDA PROFESIONAL QUE LLEVA HASTA LA FECHA?",
         "help": "Introduzca solo un número sin espacios por delante o detrás de este",
         "config": {"input": "integer", "min": 0, "max": 60}},
        {"code": "anios_desempleado", "type": "short_text", "required": true,
         "prompt": "DE LA CANTIDAD DE TIEMPO RESPONDIDA EN LA PREGUNTA ANTERIOR, ¿QUÉ CANTIDAD CORRESPONDE AL TOTAL DE TIEMPO EN QUE SE HA ENCONTRADO DESEMPLEADO?",
         "help": "Introduzca solo un número sin espacios por delante o detrás de este",
         "config": {"input": "integer", "min": 0, "max_question": "anios_profesional"}},
        {"code": "situacion_laboral", "type": "single_choice", "required": true,
         "prompt": "¿CUÁL DE LAS SIGUIENTES AFIRMACIONES DESCRIBE SU SITUACIÓN LABORAL ACTUAL?",
         "options": [["trabaja", "Actualmente me encuentro trabajando un una organización"], ["no_trabaja", "Actualmente NO trabajo"], ["emprende", "Actualmente dedico mi tiempo COMPLETO a un emprendimiento propio"]],
         "note": "La etiqueta conserva la errata del formulario ('un una') para que coincida con el CSV exportado."}
      ]
    },
    {
      "title": "Empleo actual",
      "questions": [
        {"code": "nombre_empresa", "type": "short_text", "required": false,
         "prompt": "Nombre de la empresa u organización donde trabaja actualmente:",
         "if": {"q": "situacion_laboral", "eq": "trabaja"}},
        {"code": "rubro_trabajo", "type": "single_choice", "required": false,
         "prompt": "¿CUÁL ES EL RUBRO DE LA ORGANIZACIÓN DONDE TRABAJA ACTUALMENTE?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "config": {"other_question": "otro_rubro", "require_one_of": ["rubro_trabajo", "otro_rubro"]},
         "options": [["telecomunicaciones", "Telecomunicaciones"], ["educacion", "Educación"], ["desarrollo_software", "Desarrollo de Software"], ["redes", "Redes de Computadoras"], ["salud", "Salud"], ["banca", "Banca"]]},
        {"code": "otro_rubro", "type": "short_text", "required": false,
         "prompt": "OTRO RUBRO:",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "config": {"other_for": "rubro_trabajo"}},
        {"code": "pertinencia_trabajo", "type": "likert", "required": true,
         "prompt": "En su actual puesto de trabajo las labores que se encuentra desempeñando son pertinentes a su formación como Ingeniero de Sistemas.",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": "@acuerdo4"},
        {"code": "sector_trabajo", "type": "single_choice", "required": true,
         "prompt": "EL TRABAJO EN EL QUE SE ENCUENTRA, ¿A QUÉ SECTOR CORRESPONDE?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": [["publico", "PÚBLICO"], ["privado", "PRIVADO"]]},
        {"code": "departamento_trabajo", "type": "single_choice", "required": true,
         "prompt": "¿EN QUÉ DEPARTAMENTO DE BOLIVIA TRABAJA?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": [["cochabamba", "COCHABAMBA"], ["chuquisaca", "CHUQUISACA"], ["tarija", "TARIJA"], ["la_paz", "LA PAZ"], ["oruro", "ORURO"], ["potosi", "POTOSI"], ["santa_cruz", "SANTA CRUZ"], ["beni", "BENI"], ["pando", "PANDO"], ["extranjero", "EXTRANJERO"]]},
        {"code": "area_trabajo", "type": "single_choice", "required": false,
         "prompt": "¿CUÁL ES EL ÁREA DENTRO DE LA ORGANIZACIÓN DONDE DESARROLLA SUS ACTIVIDADES PROFESIONALES?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "config": {"other_question": "otra_area", "require_one_of": ["area_trabajo", "otra_area"]},
         "options": [["contabilidad", "contabilidad"], ["administracion", "administración"], ["computo", "computo"], ["desarrollo", "desarrollo"], ["rrhh", "r.r.h.h"]]},
        {"code": "otra_area", "type": "short_text", "required": false,
         "prompt": "OTR@ AREA:",
