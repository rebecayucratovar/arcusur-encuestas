    {
      "title": "Red de contactos",
      "questions": [
        {"code": "interes_red", "type": "single_choice", "required": true,
         "prompt": "¿Le interesaría formar parte una red de contactos oficial de la Carrera de Ingeniería en Sistemas para compartir experiencias, proyectos y ofertas laborales?",
         "options": [["si", "SI"], ["no", "NO"]]},
        {"code": "email", "type": "email", "required": true,
