         "options": [["ya_trabajaba", "Ya trabajaba antes de titularse"], ["menos_1_mes", "Menos de 1 mes"], ["1_4_meses", "Entre 1 - 4 meses"], ["4_8_meses", "Entre 4 - 8 meses"], ["8_12_meses", "Entre 8 - 12 meses"], ["mas_12_meses", "Más de 12 meses"]],
         "note": "En la rama 'trabaja' el PDF no muestra qué sigue a primer_empleo; se asume igual que en 'emprende'. Confirmar."},
        {"code": "numero_empleos", "type": "single_choice", "required": true,
         "prompt": "Desde que se tituló, ¿en cuántos empleos usted se ha desempeñado? (Incluyendo su actual empleo si corresponde)",
         "if": "@tuvo_trabajo",
         "options": [["1", "1"], ["2", "2"], ["3", "3"], ["mas_3", "Más de 3"]]}
      ]
