         "prompt": "¿Ha requerido financiamiento externo para su negocio?",
         "if": {"q": "situacion_laboral", "eq": "emprende"},
         "options": [["prestamos", "Si, mediante préstamos bancarios."], ["inversores", "Si, mediante inversores."], ["propio", "No, financiamiento propio."]]},
        {"code": "satisfaccion_negocio", "type": "likert", "required": true,
