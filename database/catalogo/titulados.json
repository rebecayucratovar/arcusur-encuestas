         "config": {"other_for": "area_trabajo"}},
        {"code": "cargo_trabajo", "type": "single_choice", "required": false,
         "prompt": "¿Cuál es el cargo que desempeña en su actual trabajo?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "config": {"other_question": "otro_cargo", "require_one_of": ["cargo_trabajo", "otro_cargo"]},
         "options": [["ejecutivo", "Ejecutivo"], ["tecnico", "Técnico"], ["desarrollo", "Desarrollo"], ["help_desk", "Help Desk"]]},
        {"code": "otro_cargo", "type": "short_text", "required": false,
         "prompt": "OTR@ CARGO:",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "config": {"other_for": "cargo_trabajo"}},
        {"code": "antiguedad_trabajo", "type": "single_choice", "required": true,
         "prompt": "¿Qué antigüedad tiene en su actual trabajo?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": [["menos_1", "Menos de 1 año"], ["1_2", "Entre 1 a 2 años"], ["2_5", "Entre 2 a 5 años"], ["5_8", "Entre 5 a 8 años"], ["8_11", "Entre 8 a 11 años"], ["11_15", "Entre 11 a 15 años"], ["15_20", "Entre 15 a 20 años"], ["20_25", "Entre 20 a 25 años"], ["mas_25", "más de 25 años"]]},
        {"code": "medio_obtencion", "type": "single_choice", "required": true,
         "prompt": "¿A través de qué medio obtuvo el trabajo que actualmente desempeña?",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": [["medios_escritos", "MEDIOS ESCRITOS O AUDIOVISUALES"], ["internet", "INTERNET Y REDES SOCIALES"], ["postulacion", "POSTULACIÓN COMPETITIVA (CONVOCATORIAS PÚBLICAS Y PRIVADAS)"], ["recomendacion", "RECOMENDACIÓN DE TERCEROS"], ["otros", "OTROS"]]},
        {"code": "remuneracion", "type": "single_choice", "required": true,
         "prompt": "Señale la remuneración promedio mensual que está percibiendo en su actual trabajo.",
         "if": {"q": "situacion_laboral", "eq": "trabaja"},
         "options": [["menos_2500", "Menor a Bs. 2500"], ["2500_3500", "Entre Bs. 2.500 - Bs. 3.500"], ["3501_5000", "Entre Bs. 3.501 - Bs. 5.000"], ["5001_7000", "Entre Bs. 5.001 - Bs. 7.000"], ["7001_10000", "Entre Bs. 7.001 - Bs. 10.000"], ["mas_10000", "Más de Bs. 10.000"]]}
      ]
    },
    {
      "title": "Situación sin empleo",
      "questions": [
        {"code": "razon_no_trabaja", "type": "single_choice", "required": true,
         "prompt": "Indique cuál es la razón por la que actualmente no trabaja en un empleo relacionado con su formación como Ingeniero de Sistemas",
         "if": {"q": "situacion_laboral", "eq": "no_trabaja"},
         "options": [["demanda_inexistente", "Demanda laboral inexistente."], ["experiencia_previa", "Incumplimiento de requisitos de experiencia previa."], ["habilidades_especificas", "Incumplimiento de requisitos en habilidades específicas (idiomas, softwares, etc)."], ["red_contactos", "Red de contactos limitada."], ["presentacion_cv", "Problemas de presentación del CV."], ["entrevistas", "Habilidades deficientes en las entrevistas."], ["remuneracion_baja", "Ofertas laborales con remuneración muy bajas."], ["otro", "Otro"]]},
        {"code": "trabajo_antes", "type": "single_choice", "required": true,
         "prompt": "Si bien actualmente no trabaja, ¿Ha tenido algún trabajo antes?",
         "if": {"q": "situacion_laboral", "eq": "no_trabaja"},
         "options": [["si", "SI"], ["no", "NO"]]}
      ]
